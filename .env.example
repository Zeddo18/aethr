# Replace these examples with your own Supabase project values in .env.local.
# The publishable key is not a secret; never commit service-role or other private keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret. Set a real value in .env.local or your deployment settings.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
